# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Prisma)
# Default zero-friction local SQLite for rapid dev/test. Switch to PostgreSQL for prod:
# DATABASE_URL="postgresql://user:password@localhost:5432/ai_sdr?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Secret for Multi-Tenant Auth
JWT_SECRET="sdr-super-secret-production-key-2026-change-in-prod"
JWT_EXPIRES_IN="7d"

# AI SDR Brain Configuration
# Options: "ollama" (local low-cost), "mock" (deterministic testing), "openai" (cloud API)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Selected baseline model: qwen2.5:3b (benchmarked: 100% GPU VRAM fit, ~50 tok/s, <2s latency)
OLLAMA_MODEL=qwen2.5:3b

# Cloud LLM fallback (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telephony / Phone Voice Mock & Provider
TELEPHONY_PROVIDER=mock
TELEPHONY_WEBHOOK_SECRET=mock-telephony-secret-123

# Email Provider Configuration (SMTP / Sandbox)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEFAULT_FROM_EMAIL=alex@cloudflow-ai.com

# WhatsApp / SMS Sandbox
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=mock_whatsapp_123

# Payment Gateway (India-compatible Razorpay / Stripe Sandbox)
PAYMENT_GATEWAY=razorpay_mock
RAZORPAY_KEY_ID=rzp_test_mockkey123
RAZORPAY_KEY_SECRET=mocksecret123
STRIPE_SECRET_KEY=sk_test_mock123
