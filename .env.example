# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
# Allowed CORS origins for frontend access (accepts comma-separated list)
CORS_ORIGIN=https://nexsdr.in,https://www.nexsdr.in,https://ai-sdr-frontend-n07e.onrender.com

# Database Configuration (Prisma)
# Local SQLite (default for development):
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (Render / Supabase / Neon):
# DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# JWT Secret for Multi-Tenant Auth (generate a 64-char random string in production)
JWT_SECRET="sdr-super-secret-production-key-2026-change-in-prod"
JWT_EXPIRES_IN="7d"

# AI SDR Brain Configuration
# Options: "groq" (fast cloud free tier for Render), "online" (Gemini Flash Lite), "ollama" (local GPU), "mock"
AI_PROVIDER=ollama
VOICE_AI_PROVIDER=online

# Groq Configuration (Recommended for Render free-tier deployment)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Online Configuration
GEMINI_API_KEY=
ONLINE_GEMINI_MODEL=gemini-3.1-flash-lite

# Local Ollama Configuration (for local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Telephony / Phone Voice Mock & Provider
TELEPHONY_PROVIDER=mock
TELEPHONY_WEBHOOK_SECRET=mock-telephony-secret-123

# Email Provider Configuration (SMTP / Sandbox)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEFAULT_FROM_EMAIL=alex@cloudflow-ai.com

# WhatsApp / SMS Sandbox
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=mock_whatsapp_123

# Payment Gateway (India-compatible Razorpay / Stripe Sandbox)
PAYMENT_GATEWAY=razorpay_mock
RAZORPAY_KEY_ID=rzp_test_mockkey123
RAZORPAY_KEY_SECRET=mocksecret123
STRIPE_SECRET_KEY=sk_test_mock123

# Frontend Configuration (Vite)
# In production, set to your live backend API URL (e.g. https://<backend-service>.onrender.com/api)
# In local development, leave empty to default to the Vite proxy (/api)
VITE_API_BASE_URL=

# Optional Opportunity Engine search provider (backend only). Leave blank for public search fallback.
# Set the same variable in Render backend Environment for production.
TINYFISH_API_KEY=
