{
  "name": "@ai-sdr/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/server.js",
    "prisma:prepare": "node scripts/prepare-prisma.js",
    "prisma:generate": "node scripts/prepare-prisma.js && prisma generate",
    "prisma:push": "node scripts/prepare-prisma.js && prisma db push",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdr/shared": "*",
    "@prisma/client": "^5.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "ics": "^3.12.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.1",
    "prisma": "^5.9.1",
    "typescript": "^5.3.3",
    "ws": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "vitest": "^1.2.2"
  }
}
